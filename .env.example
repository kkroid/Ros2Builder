# External NDK cache. The container downloads and extracts Linux NDK here.
# Existing downloads/extractions are reused.
# Linux NDK r25b: https://dl.google.com/android/repository/android-ndk-r25b-linux.zip
NDK_CACHE_DIR=./ndk
NDK_VERSION=r25b
NDK_DOWNLOAD_URL=https://dl.google.com/android/repository/android-ndk-r25b-linux.zip
ANDROID_NDK_HOME=/opt/android-ndk-cache/android-ndk-r25b-linux

# Bind-mounted workspace that stores downloaded source, build, install and logs.
ROS2_ANDROID_WORKDIR=./work

ANDROID_ABI=arm64-v8a
ANDROID_API=29
ANDROID_STL=c++_shared
BUILD_SHARED_LIBS=ON

# Base image used by Dockerfile. If Docker Hub is unreachable, use a mirror.
# Default: ubuntu:22.04
# China mirror example: docker.m.daocloud.io/library/ubuntu:22.04
BASE_IMAGE=ubuntu:22.04

# Manifest used by docker compose run --rm android-build.
# Default is the minimal source set for BUILD_PACKAGES below.
# Use /manifests/ros2-humble-android-full.repos when testing optional packages.
SOURCE_MANIFEST=/manifests/ros2-humble-android.repos

# Optional proxy settings for Docker build and runtime downloads.
# Choose the proxy host name for your container runtime:
# - Docker Desktop: host.docker.internal
# - Podman: host.containers.internal
# APT works best with an HTTP/HTTPS proxy; Git and pip can also use ALL_PROXY=socks5h://...
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal,host.containers.internal

# Docker Desktop examples:
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# ALL_PROXY=socks5h://host.docker.internal:7891

# Podman examples:
# HTTP_PROXY=http://host.containers.internal:7890
# HTTPS_PROXY=http://host.containers.internal:7890
# ALL_PROXY=socks5h://host.containers.internal:7891

# Default is the smallest useful rclcpp + Fast DDS + std_msgs target set.
# Examples:
# BUILD_PACKAGES=rclcpp rmw_fastrtps_cpp std_msgs sensor_msgs geometry_msgs nav_msgs
# BUILD_PACKAGES=tf2_ros image_transport
BUILD_PACKAGES=rclcpp rmw_cyclonedds_cpp std_msgs ais_node_interface

# Harix bridge static build steps are documented in docs/ROS2_BUILD_RUNBOOK.md.
# Static-library Android demo experiment. Leave these commented for the default shared-library build.
# This uses standard ROS 2/CMake switches and writes to work/build|install|dist/android_${ANDROID_ABI}_static_dynamic.
# BUILD_OUTPUT_SUFFIX=static_dynamic
# BUILD_SHARED_LIBS=OFF
# BUILD_PACKAGES=rclcpp rmw_cyclonedds_cpp std_msgs
# RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# RMW_IMPLEMENTATION_DISABLE_RUNTIME_SELECTION=ON
# CMAKE_POSITION_INDEPENDENT_CODE=ON
# STATIC_ROSIDL_TYPESUPPORT_C=rosidl_typesupport_introspection_c
# STATIC_ROSIDL_TYPESUPPORT_CPP=rosidl_typesupport_introspection_cpp

# Optional output directory for the packaging step inside android-build.
# Default inside the bind-mounted workspace: /work/dist/android_${ANDROID_ABI}
# ARTIFACT_DIR=/work/dist/android_arm64-v8a
# ARTIFACT_CLEAN=ON
# ARTIFACT_WITH_JNILIBS=ON
# ARTIFACT_CHECKSUMS=OFF
# ARTIFACT_WITH_METADATA=OFF